{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed separately from the dashboard Worker (wrangler.jsonc), so the site
  // build and its routes are untouched:
  //   npx wrangler dev    -c wrangler.api.jsonc
  //   npx wrangler deploy -c wrangler.api.jsonc
  "name": "sentimentdash-api",
  "main": "api/worker.js",
  "compatibility_date": "2026-05-20",
  "observability": { "enabled": true },
  "vars": {
    // Seconds to memoise upstream JSON in the isolate.
    "CACHE_TTL_SECONDS": "300"
    // Comma-separated CORS allow-list. Unset = any origin (the data is public).
    // "ALLOWED_ORIGINS": "https://your-other-dashboard.example",
    // Point at a fork or a branch if you host the scrape data elsewhere.
    // "DATA_BASE_URL": "https://raw.githubusercontent.com/ceekay-munshot/sentimentdash/main/public/data/"
  }
}
